  "milestones": [
    {
      "stage": "M0",
      "title": "M0 — Foundation and decisions",
      "description": "Reproducible service, engineering workflow, product requirements, hosting/privacy/recovery decision gate. Exit: foundation CI and acceptance criteria verified."
    },
    {
      "stage": "M1",
      "title": "M1 — Private and portable knowledge",
      "description": "Trust/identity contract, exportable records, original attachment integrity and recovery. Exit: security gates and full portable collection round-trip."
    },
    {
      "stage": "M2",
      "title": "M2 — Secure multi-device synchronization",
      "description": "Versioned conflict-safe incremental synchronization across authorized devices. Exit: multi-client adversarial convergence, authorization and recovery tests."
    },
    {
      "stage": "M3",
      "title": "M3 — Native knowledge exploration and portability",
      "description": "First-party, permission-filtered and provenance-aware interactive knowledge graph with real owner-Mac evidence/navigation acceptance; optional portable Markdown/vault exchange, with no Obsidian runtime or mobile plugin requirement. Exit: #388 native graph acceptance; optional #57 remains independently gated."
    },
    {
      "stage": "M4",
      "title": "M4 — Capture and retrieval",
      "description": "Independent local capture, durable provenance, type-aware extraction and rebuildable retrieval; user-facing capture with no Obsidian dependency."
    },
    {
      "stage": "M5",
      "title": "M5 — Authorized intelligence",
      "description": "General-purpose grounded knowledge intelligence and agentic reasoning across supported technical, multimedia and structured personal sources; evaluated answers and artifacts, authorized tasks and source-aware citations. True cross-domain MVP gate #170."
    },
    {
      "stage": "M6",
      "title": "M6 — First-party clients",
      "description": "Independent first-party Praxis workbench, capture and conversational interfaces using trusted local contracts; expanded device clients after separate platform verification. First useful local UI precedes complete M6 exit."
    },
    {
      "stage": "M7",
      "title": "M7 — Operational readiness",
      "description": "Backup/restore, deployment, migration, observability and realistic resilience. Exit: rehearsed recovery, measured resource bounds and release gates."
    }
  ],
