  "delivery_lanes": [
    {
      "id": "L0",
      "name": "Local knowledge foundation (prerequisite, not complete MVP)",
      "issues": [
        99,
        122,
        124,
        126,
        128,
        100,
        102,
        101,
        105,
        103,
        106,
        129,
        108,
        146,
        113,
        166,
        130
      ],
      "exit": "On the owner's Mac, launch a trusted local Praxis workbench, automatically capture approved inputs, preserve exact originals, inspect/search supported data, organize collections, restore and verify after interruption, and deny unauthorized access. Passing this gate does not establish the complete agent-powered Praxis MVP (#170)."
    },
    {
      "id": "L1",
      "name": "Fast capture surfaces",
      "issues": [
        109,
        110,
        104,
        112,
        111
      ],
      "exit": "Intentional voice recording/transcription, explicit browser and URL capture use the same recoverable local source, original and review contracts; external websites are accessed only after consent and security checks."
    },
    {
      "id": "L2",
      "name": "Source depth and usable organization",
      "issues": [
        114,
        115,
        116,
        29
      ],
      "exit": "Configured folder monitoring, bounded rich-media metadata, reviewed suggestions and cross-source collections survive rebuild/reprocessing without inventing source facts."
    },
    {
      "id": "L3",
      "name": "Agent interoperability",
      "issues": [
        107,
        117,
        118,
        119
      ],
      "exit": "An independently authorized local integration host and paired agent can retrieve only scoped grounded knowledge; write operations require separate permissions and approval, with revocation and prompt-injection tests."
    },
    {
      "id": "L4",
      "name": "Technical knowledge slice within the cross-domain MVP",
      "issues": [
        149,
        152,
        153,
        154,
        150,
        155,
        156
      ],
      "exit": "Process a supported versioned technical corpus, correlate evidence across code/disassembly/notes, answer a genuine technical question with citations or abstain. This is one of multiple required domains, not the definition of the entire MVP."
    },
    {
      "id": "L5",
      "name": "Extended connector history and optional interaction capabilities",
      "issues": [
        151,
        157,
        158,
        159,
        162,
        160,
        161
      ],
      "exit": "One explicitly authorized typed connector demonstrates incremental history, replay, revocation and provenance without unnecessary AI classification; proposed agent tools require independently enforced approval. Conversational offline voice remains a separately verified user interaction, not a mandatory connector feature."
    },
    {
      "id": "L6",
      "name": "Integrated general-purpose intelligent Second Brain MVP",
      "issues": [
        31,
        32,
        33,
        34,
        57,
        61,
        62,
        98,
        143,
        170,
        171,
        172,
        173,
        176,
        177,
        178,
        179
      ],
      "exit": "Owner-run, local-first end-to-end proof across at least three representative supported knowledge domains: (1) cross-artifact technical research, (2) relevant timecoded video segment playable inside chat with full-source navigation, and (3) verified editable monthly budgeting from explicitly authorized bills, income and transaction data. Also demonstrate semantic/structural retrieval and agentic investigation, provenance, reviewable knowledge, approved task execution, Obsidian views, efficient agent contexts, measured provider escalation, and reliability/privacy/revocation/cost tests."
    }
  ]
}
